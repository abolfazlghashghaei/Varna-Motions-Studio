<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.jakeinmotion.railcut"
                   ExtensionBundleVersion="1.1.0"
                   ExtensionBundleName="Railcut"
                   Version="6.0">

    <ExtensionList>
        <Extension Id="com.jakeinmotion.railcut.panel" Version="1.1.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2024 (24.0) through 2025+ -->
            <Host Name="AEFT" Version="[18.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="10.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.jakeinmotion.railcut.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <!-- ScriptPath works for most users (loads script before panel JS runs).
                         For Unicode usernames where ScriptPath silently fails, loadHostScript()
                         in cep.ts re-loads via cep.fs.readFile as a fallback. Double-load is
                         harmless — function declarations just overwrite. -->
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Railcut</Menu>
                    <Geometry>
                        <Size>
                            <Height>300</Height>
                            <Width>800</Width>
                        </Size>
                        <MinSize>
                            <Height>200</Height>
                            <Width>400</Width>
                        </MinSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon-light.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-dark.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>

    <CSPPolicies>
        <CSPPolicy Type="JavaScript">
            connect-src 'self' https://api.lemonsqueezy.com https://api.jakeinmotion.dev;
            script-src 'self' 'unsafe-inline';
            default-src 'self';
        </CSPPolicy>
    </CSPPolicies>
</ExtensionManifest>
